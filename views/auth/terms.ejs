  <main class="max-w-3xl mx-auto px-4 py-12">

    <div class="mb-8">
      <h1 class="text-3xl font-bold text-neutral-900">Terms &amp; Conditions</h1>
      <p class="text-neutral-500 mt-2">Last updated: January 12, 2025</p>
