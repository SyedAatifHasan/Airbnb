<div class="mt-4">
  <form action="/favourite-list" method="POST">
    <button
      type="submit"
      class="w-full inline-flex items-center justify-center whitespace-nowrap text-gray-700 bg-white border border-gray-300 hover:bg-green-50 hover:border-green-400 hover:text-green-600 shadow-sm font-medium leading-5 rounded-lg text-sm px-3 py-2.5 transition duration-300 focus:outline-none focus:ring-4 focus:ring-green-200"
    >
      <svg
        class="w-4 h-4 me-1.5"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        fill="none"
        viewBox="0 0 24 24"
      >
        <path
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M12 21C12 21 4 14.5 4 9.5C4 6.5 6.5 4 9.5 4C11 4 12 5 12 5C12 5 13 4 14.5 4C17.5 4 20 6.5 20 9.5C20 14.5 12 21 12 21Z"
        />
      </svg>
      Add to Favorite
    </button>
    <input type="hidden" name="id" value="<%= home._id %>" />

  </form>
</div>
