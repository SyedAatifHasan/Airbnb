<% if (toastMessages && toastMessages.length) { %>
<div id="toast-container" class="fixed top-5 right-5 z-[100] space-y-2">
  <% toastMessages.forEach(msg => { %>
    <div class="bg-gray-900 text-white px-4 py-2 rounded-lg shadow-lg toast-item"><%= msg %></div>
  <% }) %>
</div>
<script>
  setTimeout(() => document.getElementById('toast-container')?.remove(), 4000);
</script>
<% } %>