<%- include('../partials/header') %>
</head>

<body class="bg-neutral-50 min-h-screen">
  <%- include('../partials/toast') %>
  <%- include('../partials/nav') %>

  <!-- Form Section -->
  <main class="flex justify-center items-start py-12 px-4">
    <div class="w-full max-w-2xl">

      <!-- Page heading -->
      <div class="mb-8 text-center">
        <h2 class="text-3xl font-bold text-neutral-900">
          <%= editing ? "Edit your home" : "Tell us about your place" %>
        </h2>
        <p class="text-neutral-500 mt-2">
          <%= editing ? "Update the details guests will see." : "Share a few details so guests know what to expect." %>
        </p>
      </div>

      <div class="bg-white rounded-2xl shadow-sm border border-neutral-200 p-6 sm:p-10">
        <%- include('../partials/errors') %>

        <form action="/host/<%= editing ? 'edit-home' : 'add-home' %>" method="POST" class="space-y-10" enctype="multipart/form-data">
          <input type="hidden" name="id" value="<%= editing ? home._id : '' %>">
          <!-- Photo -->
          <section>
            <h3 class="text-lg font-semibold text-neutral-900 mb-1">Photo</h3>
            <p class="text-sm text-neutral-500 mb-4">A great photo helps your listing stand out.</p>

            <label for="image" class="block cursor-pointer group">
              <div id="imagePreviewWrap" class="relative w-full aspect-[16/9] rounded-xl border-2 border-dashed border-neutral-300 bg-neutral-50 overflow-hidden flex items-center justify-center group-hover:border-rose-400 transition-colors">
                <img id="imagePreview" src="<%= editing && home.image ? home.image : '' %>" class="w-full h-full object-cover <%= editing && home.image ? '' : 'hidden' %>" alt="Home preview">
                <div id="imagePlaceholder" class="<%= editing && home.image ? 'hidden' : '' %> flex flex-col items-center text-neutral-400 px-4 text-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 7.5L12 3m0 0L7.5 7.5M12 3v13.5" />
                  </svg>
                  <span class="text-sm font-medium text-neutral-500">Click to choose a file</span>
                  <span class="text-xs mt-1">PNG or JPG, up to a few MB</span>
                </div>
              </div>
            </label>

            <label for="image" class="mt-3 inline-flex items-center gap-2 border border-neutral-300 rounded-lg px-4 py-2.5 text-sm font-medium text-neutral-700 cursor-pointer hover:bg-neutral-50 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 7.5L12 3m0 0L7.5 7.5M12 3v13.5" />
              </svg>
              <span id="fileLabel">Choose file</span>
            </label>
            <input id="image" type="file" name="image" accept="image/*" class="hidden">
          </section>

          <hr class="border-neutral-200">

          <!-- Basics -->
          <section class="space-y-5">
            <h3 class="text-lg font-semibold text-neutral-900">The basics</h3>

            <div>
              <label for="houseName" class="block text-sm font-medium text-neutral-700 mb-1.5">Home name</label>
              <input id="houseName" type="text" name="houseName" value="<%= editing ? home.houseName : '' %>" placeholder="e.g. Cozy riverside cottage" class="w-full border border-neutral-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-transparent">
            </div>

            <div>
              <label for="location" class="block text-sm font-medium text-neutral-700 mb-1.5">Location</label>
              <div class="relative">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
                <input id="location" type="text" name="location" value="<%= editing ? home.location : '' %>" placeholder="City, Country" class="w-full border border-neutral-300 rounded-lg pl-11 pr-4 py-3 focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-transparent">
              </div>
            </div>

            <div>
              <label for="price" class="block text-sm font-medium text-neutral-700 mb-1.5">Price per night</label>
              <div class="relative">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-neutral-500">$</span>
                <input id="price" type="number" min="0" name="price" value="<%= editing ? home.price : '' %>" placeholder="0" class="w-full border border-neutral-300 rounded-lg pl-8 pr-4 py-3 focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-transparent">
              </div>
            </div>
          </section>

          <hr class="border-neutral-200">

          <!-- Description -->
          <section>
            <div class="flex items-baseline justify-between mb-1.5">
              <label for="description" class="block text-sm font-medium text-neutral-700">Description</label>
              <span id="descCount" class="text-xs text-neutral-400">0 characters</span>
            </div>
            <textarea id="description" name="description" rows="5" maxlength="600" placeholder="Describe what makes your place special — the space, the neighborhood, nearby attractions..." class="w-full border border-neutral-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-transparent resize-none"><%= editing ? home.description : '' %></textarea>
          </section>
          <hr class="border-neutral-200">

          <!-- House Rules -->
          <section>
            <div class="flex items-center justify-between mb-1.5">
              <label class="block text-sm font-medium text-neutral-700">House rules</label>
              <button type="button" id="openRulesModal" class="text-sm font-medium text-rose-600 hover:text-rose-700">
                <%= editing && home.rules && home.rules.length ? "Edit rules" : "Add rules" %>
              </button>
            </div>
            <div id="rulesPreview" class="text-sm text-neutral-500 border border-dashed border-neutral-300 rounded-lg px-4 py-3">
              <% if (editing && home.rules && home.rules.length) { %>
              <ul class="list-disc list-inside space-y-1">
                <% home.rules.forEach(rule => { %>
                <li><%= rule %></li>
                <% }) %>
              </ul>
              <% } else { %>
              <span>No rules added yet.</span>
              <% } %>
            </div>
            <textarea id="rules" name="rules" class="hidden"><%= editing && home.rules ? home.rules.join('\n') : '' %></textarea>
          </section>

          <!-- Submit -->
          <div class="pt-2">
            <button type="submit" class="w-full bg-red-500 text-white py-3 rounded-lg font-semibold hover:bg-red-600 transition duration-300">
              <%= editing ? "Update Home" : "Register Home" %>
            </button>
          </div>

        </form>
      </div>
    </div>
  </main>
  <!-- Rules Modal -->
  <div id="rulesModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 px-4">
    <div class="bg-white rounded-2xl shadow-lg w-full max-w-lg p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-neutral-900">House rules</h3>
        <button type="button" id="closeRulesModal" class="text-neutral-400 hover:text-neutral-600">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <p class="text-sm text-neutral-500 mb-3">One rule per line — e.g. "No smoking", "No pets", "Quiet hours after 10pm".</p>
      <textarea id="rulesModalInput" rows="8" class="w-full border border-neutral-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-transparent resize-none" placeholder="No smoking&#10;No pets&#10;No parties or events"></textarea>
      <div class="mt-4 flex justify-end gap-3">
        <button type="button" id="cancelRulesModal" class="px-4 py-2 text-sm font-medium text-neutral-600 hover:text-neutral-800">Cancel</button>
        <button type="button" id="saveRulesModal" class="px-4 py-2 rounded-lg bg-red-500 text-white text-sm font-semibold hover:bg-red-600">Save rules</button>
      </div>
    </div>
  </div>
  <script>
    const imageInput = document.getElementById('image');
    const imagePreview = document.getElementById('imagePreview');
    const imagePlaceholder = document.getElementById('imagePlaceholder');
    const fileLabel = document.getElementById('fileLabel');

    imageInput.addEventListener('change', () => {
      const file = imageInput.files && imageInput.files[0];

      if (!file) {
        imagePreview.classList.add('hidden');
        imagePlaceholder.classList.remove('hidden');
        fileLabel.textContent = 'Choose file';
        return;
      }

      fileLabel.textContent = file.name;

      const reader = new FileReader();
      reader.onload = (e) => {
        imagePreview.src = e.target.result;
        imagePreview.classList.remove('hidden');
        imagePlaceholder.classList.add('hidden');
      };
      reader.readAsDataURL(file);
    });

    const description = document.getElementById('description');
    const descCount = document.getElementById('descCount');

    function updateCount() {
      descCount.textContent = `${description.value.length} / 600 characters`;
    }
    description.addEventListener('input', updateCount);
    updateCount();
    const rulesTextarea = document.getElementById('rules');
    const rulesPreview = document.getElementById('rulesPreview');
    const rulesModal = document.getElementById('rulesModal');
    const rulesModalInput = document.getElementById('rulesModalInput');
    const openRulesModal = document.getElementById('openRulesModal');
    const closeRulesModal = document.getElementById('closeRulesModal');
    const cancelRulesModal = document.getElementById('cancelRulesModal');
    const saveRulesModal = document.getElementById('saveRulesModal');

    function renderRulesPreview(text) {
      const lines = text.split('\n').map(l => l.trim()).filter(Boolean);
      if (!lines.length) {
        rulesPreview.innerHTML = '<span>No rules added yet.</span>';
        return;
      }
      rulesPreview.innerHTML = '<ul class="list-disc list-inside space-y-1">' +
        lines.map(l => `<li>${l.replace(/</g, '&lt;')}</li>`).join('') +
        '</ul>';
    }

    function showRulesModal() {
      rulesModalInput.value = rulesTextarea.value;
      rulesModal.classList.remove('hidden');
    }

    function hideRulesModal() {
      rulesModal.classList.add('hidden');
    }

    openRulesModal.addEventListener('click', showRulesModal);
    closeRulesModal.addEventListener('click', hideRulesModal);
    cancelRulesModal.addEventListener('click', hideRulesModal);

    saveRulesModal.addEventListener('click', () => {
      rulesTextarea.value = rulesModalInput.value;
      renderRulesPreview(rulesTextarea.value);
      hideRulesModal();
    });
  </script>

</body>

</html>