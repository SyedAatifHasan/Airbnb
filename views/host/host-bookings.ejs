<%- include('../partials/header') %>
  </head>

  <body class="bg-gray-100 min-h-screen">
    <%- include('../partials/toast') %>
      <%- include('../partials/nav') %>
        <main class="flex flex-col items-center justify-center">
          <section class="max-w-7xl w-full mx-auto mt-5 mb-16 px-2">
            <h3 class="text-2xl font-bold text-gray-800 mb-6 text-center">
              Booking Requests</h3>

            <% if (bookings.length===0) { %>
              <p class="text-center text-gray-500">No bookings yet.</p>
              <% } else { %>

                <!-- Filter bar -->
                <div
                  class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 mb-4 flex flex-col sm:flex-row gap-3">
                  <div class="relative flex-1">
                    <i
                      class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                    <input id="booking-search" type="text" placeholder="Search by property or guest..."
                      oninput="applyBookingFilters()"
                      class="w-full pl-9 pr-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-400" />
                  </div>
                  <select id="booking-status-filter" onchange="applyBookingFilters()"
                    class="text-sm border border-gray-200 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-400">
                    <option value="all">All statuses</option>
                    <option value="pending">Pending</option>
                    <option value="confirmed">Confirmed</option>
                    <option value="rejected">Rejected</option>
                    <option value="cancelled">Cancelled</option>
                    <option value="arrived">Arrived</option>
                    <option value="returned">Returned</option>
                  </select>
                </div>

                <div class="space-y-4">
                  <% bookings.forEach(booking=> { %>
                    <div id="booking-<%= booking._id %>"
                      class="booking-card bg-white border border-gray-200 rounded-xl shadow-sm p-5 flex flex-col sm:flex-row sm:items-center gap-4 transition"
                      data-house="<%= booking.home.houseName %>"
                      data-guest="<%= [booking.guest.fname, booking.guest.mname, booking.guest.lname].filter(Boolean).join(' ') %>"
                      data-status="<%= booking.status %>">

                      <img src="<%= booking.home.image %>" class="w-full sm:w-32 h-24 object-cover rounded-lg"
                        alt="<%= booking.home.houseName %>" />

                      <div class="flex-1">
                        <h5 class="text-lg font-semibold text-gray-800">
                          <%= booking.home.houseName %>
                        </h5>
                        <p class="text-sm text-gray-500">
                          <%= new Date(booking.checkIn).toLocaleDateString() %> → <%= new
                              Date(booking.checkOut).toLocaleDateString() %>
                              &middot; <%= booking.familyCount %> guest(s)
                        </p>
                        <p class="text-sm text-gray-600 mt-1">
                          Guest:
                          <button type="button"
                            class="guest-trigger font-medium text-blue-600 hover:text-blue-800 hover:underline"
                            data-guest='<%- JSON.stringify({
                image: booking.guest.profileImage || "/uploads/default-profile.png",
                name: [booking.guest.fname, booking.guest.mname, booking.guest.lname].filter(Boolean).join(" "),
                email: booking.guest.email,
                phone: booking.guest.phone || "",
                feedback: feedbackByGuest[booking.guest._id.toString()] || []
              }).replace(/' /g, "&#39;" ) %>'>
                            <%= booking.guest.fname %>
                              <%= booking.guest.mname %>
                                <%= booking.guest.lname %>
                          </button>
                          &middot; <%= booking.guest.email %>
                            <% if (booking.guest.phone) { %> &middot; <%= booking.guest.phone %>
                                <% } %>
                        </p>
                        <p class="text-sm font-semibold text-red-500 mt-1">Offered: Rs. <%= booking.offeredPrice %>
                        </p>
                      </div>

                      <div class="flex flex-col items-end gap-2 shrink-0">
                        <span class="text-xs font-semibold px-2.5 py-1 rounded-full
                  <%= booking.status === 'confirmed' ? 'bg-green-100 text-green-700' :
                      booking.status === 'rejected' ? 'bg-red-100 text-red-700' :
                      booking.status === 'cancelled' ? 'bg-gray-200 text-gray-600' :
                      booking.status === 'arrived' ? 'bg-blue-100 text-blue-700' :
                      booking.status === 'returned' ? 'bg-purple-100 text-purple-700' :
                      'bg-yellow-100 text-yellow-700' %>">
                          <%= booking.status %>
                        </span>

                        <% if (booking.status==='pending' ) { %>
                          <div class="flex gap-2">
                            <form action="/host/bookings/update-status" method="POST">
                              <input type="hidden" name="bookingId" value="<%= booking._id %>" />
                              <input type="hidden" name="status" value="confirmed" />
                              <button
                                class="text-xs bg-green-500 hover:bg-green-600 text-white px-3 py-1.5 rounded-lg">Confirm</button>
                            </form>
                            <form action="/host/bookings/update-status" method="POST">
                              <input type="hidden" name="bookingId" value="<%= booking._id %>" />
                              <input type="hidden" name="status" value="rejected" />
                              <button
                                class="text-xs bg-red-500 hover:bg-red-600 text-white px-3 py-1.5 rounded-lg">Reject</button>
                            </form>
                          </div>
                          <% } else if (booking.status==='confirmed' ) { %>
                            <div class="flex gap-2">
                              <form action="/host/bookings/update-status" method="POST">
                                <input type="hidden" name="bookingId" value="<%= booking._id %>" />
                                <input type="hidden" name="status" value="arrived" />
                                <button
                                  class="text-xs bg-blue-500 hover:bg-blue-600 text-white px-3 py-1.5 rounded-lg">Mark
                                  Arrived</button>
                              </form>
                              <form action="/host/bookings/update-status" method="POST">
                                <input type="hidden" name="bookingId" value="<%= booking._id %>" />
                                <input type="hidden" name="status" value="cancelled" />
                                <button
                                  class="text-xs bg-gray-500 hover:bg-gray-600 text-white px-3 py-1.5 rounded-lg">Cancel</button>
                              </form>
                            </div>
                            <% } else if (booking.status==='arrived' ) { %>
                              <form action="/host/bookings/update-status" method="POST">
                                <input type="hidden" name="bookingId" value="<%= booking._id %>" />
                                <input type="hidden" name="status" value="returned" />
                                <button
                                  class="text-xs bg-purple-500 hover:bg-purple-600 text-white px-3 py-1.5 rounded-lg">Mark
                                  Returned</button>
                              </form>
                              <% } %>

                                <% if (booking.status==='returned' && !(booking.hostFeedback &&
                                  booking.hostFeedback.rating)) { %>
                                  <form action="/host/bookings/host-feedback" method="POST"
                                    class="mt-2 w-full sm:w-56 space-y-1">
                                    <input type="hidden" name="bookingId" value="<%= booking._id %>" />
                                    <select name="rating" required
                                      class="w-full text-xs border border-gray-300 rounded-lg px-2 py-1">
                                      <option value="">Rate guest</option>
                                      <option value="5">5 - Excellent</option>
                                      <option value="4">4 - Good</option>
                                      <option value="3">3 - Average</option>
                                      <option value="2">2 - Below average</option>
                                      <option value="1">1 - Poor</option>
                                    </select>
                                    <textarea name="comment" rows="2" required placeholder="Feedback about the guest..."
                                      class="w-full text-xs border border-gray-300 rounded-lg px-2 py-1"></textarea>
                                    <button
                                      class="text-xs bg-indigo-500 hover:bg-indigo-600 text-white px-3 py-1 rounded-lg w-full">Submit
                                      Guest Feedback</button>
                                  </form>
                                  <% } else if (booking.hostFeedback && booking.hostFeedback.rating) { %>
                                    <div class="text-xs text-gray-500 mt-1">You rated this guest ★ <%=
                                        booking.hostFeedback.rating %>/5</div>
                                    <% } %>
                      </div>
                    </div>
                    <% }); %>

                      <p id="no-booking-results"
                        class="hidden bg-white border border-gray-200 rounded-xl p-8 text-center text-gray-400 text-sm">
                        No bookings match your filters.
                      </p>
                </div>
                <% } %>
          </section>
        </main>

        <!-- Guest profile modal (unchanged) -->
        <div id="guest-modal" class="hidden fixed inset-0 z-50 bg-black/50 items-center justify-center p-4">
          <div class="bg-white rounded-xl shadow-xl max-w-sm w-full p-6 relative">
            <button type="button" onclick="closeGuestModal()"
              class="absolute top-3 right-3 text-gray-400 hover:text-gray-600">
              <i class="fa-solid fa-xmark text-lg"></i>
            </button>
            <div class="flex flex-col items-center text-center">
              <img id="modal-guest-image" src="" alt="Guest"
                class="w-24 h-24 rounded-full object-cover border-2 border-gray-200 mb-4" />
              <h4 id="modal-guest-name" class="text-lg font-semibold text-gray-800"></h4>
              <p id="modal-guest-email" class="text-sm text-gray-500 mt-1"></p>
              <p id="modal-guest-phone" class="text-sm text-gray-500 mt-1"></p>
              <div id="modal-guest-feedback" class="w-full mt-4 text-left max-h-40 overflow-y-auto space-y-2"></div>
            </div>
          </div>
        </div>

        <script>
          function openGuestModal(data) {
            document.getElementById('modal-guest-image').src = data.image;
            document.getElementById('modal-guest-name').textContent = data.name;
            document.getElementById('modal-guest-email').textContent = data.email;
            document.getElementById('modal-guest-phone').textContent = data.phone ? data.phone : 'No phone on file';

            const feedbackEl = document.getElementById('modal-guest-feedback');
            if (data.feedback && data.feedback.length) {
              feedbackEl.innerHTML = '<h5 class="text-sm font-semibold text-gray-700 mb-1">Past host feedback</h5>' +
                data.feedback.map(f =>
                  `<div class="bg-gray-50 rounded-lg p-2 text-xs">
            <span class="text-yellow-500 font-medium">★ ${f.rating}/5</span>
            <p class="text-gray-600">${f.comment || ''}</p>
          </div>`
                ).join('');
            } else {
              feedbackEl.innerHTML = '<p class="text-xs text-gray-400">No feedback from other hosts yet.</p>';
            }
            const modal = document.getElementById('guest-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
          }

          function closeGuestModal() {
            const modal = document.getElementById('guest-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
          }

          document.querySelectorAll('.guest-trigger').forEach(btn => {
            btn.addEventListener('click', () => {
              const data = JSON.parse(btn.dataset.guest);
              openGuestModal(data);
            });
          });

          function applyBookingFilters() {
            const search = document.getElementById('booking-search').value.trim().toLowerCase();
            const status = document.getElementById('booking-status-filter').value;
            let anyVisible = false;

            document.querySelectorAll('.booking-card').forEach(card => {
              const house = (card.dataset.house || '').toLowerCase();
              const guest = (card.dataset.guest || '').toLowerCase();
              const cardStatus = card.dataset.status;
              const matchesSearch = !search || house.includes(search) || guest.includes(search);
              const matchesStatus = status === 'all' || cardStatus === status;
              const show = matchesSearch && matchesStatus;
              card.classList.toggle('hidden', !show);
              if (show) anyVisible = true;
            });

            document.getElementById('no-booking-results').classList.toggle('hidden', anyVisible);
          }

          (function () {
            const bookingId = new URLSearchParams(window.location.search).get('bookingId');
            if (!bookingId) return;
            const el = document.getElementById('booking-' + bookingId);
            if (!el) return;
            el.scrollIntoView({
              behavior: 'smooth',
              block: 'center'
            });
            el.classList.add('ring-2', 'ring-indigo-400');
            setTimeout(() => el.classList.remove('ring-2', 'ring-indigo-400'), 3000);
          })();
        </script>
  </body>
</html>