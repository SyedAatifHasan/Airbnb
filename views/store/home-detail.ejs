<%- include('../partials/header') %>
  </head>

  <body class="bg-gray-100 min-h-screen">
    <%- include('../partials/toast') %>
    <%- include('../partials/nav') %>

    <!-- Home Details Section -->
    <main class="flex flex-col items-center justify-center">
      <section class="max-w-4xl w-full mx-auto mt-10 mb-16 px-4">
        <div class="bg-white rounded-xl shadow-md overflow-hidden">

          <!-- Photo -->
          <img
            class="w-full h-80 object-cover"
            src="<%= home.image %>"
            alt="<%= home.houseName %>"
          />

          <div class="p-8">

            <!-- Title + Location -->
            <div class="flex items-start justify-between gap-4 mb-1">
              <h1 class="text-3xl font-bold text-gray-800">
                <%= home.houseName %>
              </h1>
              <span class="flex items-center shrink-0 text-sm font-medium text-gray-700 bg-yellow-100 px-3 py-1 rounded-full">
                <svg class="w-4 h-4 text-yellow-500 me-1" fill="currentColor" viewBox="0 0 24 24"><path d="M13.849 4.22c-.684-1.626-3.014-1.626-3.698 0L8.397 8.387l-4.552.361c-1.775.14-2.495 2.331-1.142 3.477l3.468 2.937-1.06 4.392c-.413 1.713 1.472 3.067 2.992 2.149L12 19.35l3.897 2.354c1.52.918 3.405-.436 2.992-2.15l-1.06-4.39 3.468-2.938c1.353-1.146.633-3.336-1.142-3.477l-4.552-.36-1.754-4.17Z"/></svg>
                <%= home.ratting %>
              </span>
            </div>

            <!-- NEW: occupancy badge -->
            <div class="mb-2">
              <% if (occupied) { %>
                <span class="inline-flex items-center gap-1 text-xs font-medium text-blue-700 bg-blue-50 rounded-full px-2.5 py-1">
                  <i class="fa-solid fa-house-user"></i> Currently occupied
                </span>
              <% } else { %>
                <span class="inline-flex items-center gap-1 text-xs font-medium text-green-700 bg-green-50 rounded-full px-2.5 py-1">
                  <i class="fa-solid fa-circle-check"></i> Available now
                </span>
              <% } %>
            </div>

            <p class="text-xs text-gray-400 mb-2"><%= bookingCount %> total bookings</p>

            <p class="text-sm text-gray-500 mb-4 flex items-center">
              <svg class="w-4 h-4 me-1 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <%= home.location %>
            </p>

            <!-- Price -->
            <p class="text-2xl font-extrabold text-red-500 mb-6">
              Rs. <%= home.price %> <span class="text-gray-500 text-base font-normal">/ night</span>
            </p>

            <!-- Description -->
            <div class="mb-8">
              <h2 class="text-lg font-semibold text-gray-800 mb-2">About this place</h2>
              <p class="text-gray-600 leading-relaxed">
                <%= home.description %>
              </p>
            </div>

            <% if (user && user.usertype === 'guest') { %>
            <div class="mt-4">
              <a href="/rules/<%= home._id %>"
                class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg border border-gray-300 text-sm font-medium text-gray-700 hover:bg-gray-50 hover:border-gray-400 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 12m0 0l4.5-4.5M12 12V3" />
                </svg>
                Download House Rules
              </a>
            </div>

            <%- include('../partials/favourite') %>
            <% } %>

            <!-- ============ BOOKING FORM (guest, home not occupied) ============ -->
            <% if (user && user.usertype === 'guest') { %>
            <div class="mt-8 border-t pt-6">
              <% if (occupied) { %>
                <div class="bg-blue-50 border border-blue-100 rounded-lg p-4 flex items-center gap-3">
                  <i class="fa-solid fa-house-user text-blue-500 text-lg"></i>
                  <div>
                    <h2 class="text-lg font-semibold text-gray-800 mb-0.5">This home is currently occupied</h2>
                    <p class="text-sm text-gray-600">Check back later, or browse other available homes for now.</p>
                  </div>
                </div>
              <% } else { %>
                <h2 class="text-lg font-semibold text-gray-800 mb-4">Book this place</h2>
                <form action="/bookings/create" method="POST" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <input type="hidden" name="homeId" value="<%= home._id %>" />

                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Check-in</label>
                    <input type="date" name="checkIn" required
                      class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-red-300 focus:outline-none" />
                  </div>

                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Check-out</label>
                    <input type="date" name="checkOut" required
                      class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-red-300 focus:outline-none" />
                  </div>

                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Family / guest count</label>
                    <input type="number" name="familyCount" min="1" value="1" required
                      class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-red-300 focus:outline-none" />
                  </div>

                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Your offered price (Rs./night)</label>
                    <input type="number" name="offeredPrice" min="1" value="<%= home.price %>" required
                      class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-red-300 focus:outline-none" />
                  </div>

                  <button type="submit"
                    class="sm:col-span-2 bg-red-500 hover:bg-red-600 text-white font-semibold py-2.5 rounded-lg transition duration-300">
                    Request Booking
                  </button>
                </form>
              <% } %>
            </div>
            <% } %>

            <!-- ============ GUEST: feedback form for each returned stay without feedback ============ -->
            <% if (user && user.usertype === 'guest' && userBookings && userBookings.length) { %>
              <% userBookings.filter(b => b.status === 'returned' && !(b.guestFeedback && b.guestFeedback.rating)).forEach(function(b) { %>
              <div class="mt-8 border-t pt-6">
                <h2 class="text-lg font-semibold text-gray-800 mb-4">
                  How was your stay (<%= new Date(b.checkIn).toLocaleDateString() %> → <%= new Date(b.checkOut).toLocaleDateString() %>)?
                </h2>
                <form action="/bookings/guest-feedback" method="POST" class="space-y-4">
                  <input type="hidden" name="bookingId" value="<%= b._id %>" />
                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Your rating</label>
                    <select name="rating" required class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-red-300 focus:outline-none">
                      <option value="">Select rating</option>
                      <option value="5">5 - Excellent</option>
                      <option value="4">4 - Good</option>
                      <option value="3">3 - Average</option>
                      <option value="2">2 - Below average</option>
                      <option value="1">1 - Poor</option>
                    </select>
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Your feedback</label>
                    <textarea name="comment" rows="3" required class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-red-300 focus:outline-none" placeholder="Tell future guests about this place and the host..."></textarea>
                  </div>
                  <button type="submit" class="bg-red-500 hover:bg-red-600 text-white font-semibold py-2.5 px-6 rounded-lg transition duration-300">
                    Submit Feedback
                  </button>
                </form>
              </div>
              <% }); %>
            <% } %>

            <!-- Already submitted feedback for past stays -->
            <% if (userBookings && userBookings.some(b => b.guestFeedback && b.guestFeedback.rating)) { %>
            <div class="mt-8 border-t pt-6">
              <h2 class="text-lg font-semibold text-gray-800 mb-2">Your feedback</h2>
              <% userBookings.filter(b => b.guestFeedback && b.guestFeedback.rating).forEach(function(b) { %>
              <div class="bg-gray-50 rounded-lg p-4 mb-2">
                <span class="text-xs text-gray-400"><%= new Date(b.checkIn).toLocaleDateString() %> → <%= new Date(b.checkOut).toLocaleDateString() %></span>
                <div><span class="text-yellow-500 font-medium">★ <%= b.guestFeedback.rating %>/5</span></div>
                <p class="text-gray-600 mt-1"><%= b.guestFeedback.comment %></p>
              </div>
              <% }); %>
            </div>
            <% } %>

            <!-- ============ ALL GUEST REVIEWS FOR THIS HOME (+ host reply) ============ -->
            <% if (reviews && reviews.length > 0) { %>
            <div class="mt-8 border-t pt-6">
              <h2 class="text-lg font-semibold text-gray-800 mb-4">
                Guest reviews (<%= reviews.length %>)
              </h2>
              <div class="space-y-4">
                <% reviews.forEach(function(r) { %>
                <div class="bg-gray-50 rounded-lg p-4">
                  <div class="flex items-center justify-between mb-1">
                    <span class="font-medium text-gray-800">
                      <%= [r.guest.fname, r.guest.mname, r.guest.lname].filter(Boolean).join(' ') %>
                    </span>
                    <span class="text-yellow-500 text-sm font-medium">★ <%= r.guestFeedback.rating %>/5</span>
                  </div>
                  <p class="text-gray-600 text-sm"><%= r.guestFeedback.comment %></p>

                  <% if (r.guestFeedback.hostReply && r.guestFeedback.hostReply.comment) { %>
                    <div class="mt-3 ml-4 pl-3 border-l-2 border-gray-300">
                      <span class="text-xs font-semibold text-gray-700">Response from host</span>
                      <p class="text-gray-600 text-sm mt-0.5"><%= r.guestFeedback.hostReply.comment %></p>
                    </div>
                  <% } else if (user && user.usertype === 'host' && home.hostId.toString() === user._id.toString()) { %>
                    <form action="/homes/reviews/reply" method="POST" class="mt-3 ml-4 pl-3 border-l-2 border-gray-200 space-y-1">
                      <input type="hidden" name="bookingId" value="<%= r._id %>" />
                      <textarea name="reply" rows="2" required placeholder="Reply to this guest's review..."
                        class="w-full text-xs border border-gray-300 rounded-lg px-2 py-1"></textarea>
                      <button type="submit" class="text-xs bg-gray-700 hover:bg-gray-800 text-white px-3 py-1 rounded-lg">
                        Post Reply
                      </button>
                    </form>
                  <% } %>
                </div>
                <% }); %>
              </div>
            </div>
            <% } %>

          </div>
        </div>
      </section>
    </main>
  </body>
</html>
