<%- include('../partials/header') %>
  </head>

  <body class="bg-gray-100 min-h-screen">
    <%- include('../partials/toast') %>
    <%- include('../partials/nav') %>

    <main class="flex flex-col items-center justify-center">
      <section class="max-w-7xl w-full mx-auto mt-5 mb-16 px-2">
        <h3 class="text-2xl font-bold text-gray-800 mb-6 text-center">
          Favourite Homes
        </h3>

        <% if (favouriteHome.length > 0) { %>

          <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 mb-6 flex flex-col md:flex-row gap-3 max-w-5xl mx-auto">
            <div class="relative flex-1">
              <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 10a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
              <input
                id="home-search"
                type="text"
                placeholder="Search by location or description..."
                oninput="applyHomeFilters()"
                class="w-full pl-9 pr-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-300"
              />
            </div>

            <select id="home-status-filter" onchange="applyHomeFilters()"
              class="text-sm border border-gray-200 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-red-300">
              <option value="all">All homes</option>
              <option value="vacant">Available now</option>
              <option value="occupied">Currently occupied</option>
            </select>

            <select id="home-sort" onchange="applyHomeFilters()"
              class="text-sm border border-gray-200 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-red-300">
              <option value="rating-desc">Highest rated</option>
              <option value="price-asc">Price (low to high)</option>
              <option value="price-desc">Price (high to low)</option>
            </select>
          </div>

          <p id="home-results-count" class="text-xs text-gray-400 mb-3 text-center"></p>

          <div id="home-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            <% favouriteHome.forEach((home) => { %>
              <div class="home-card bg-white shadow-lg rounded-lg overflow-hidden flex flex-col"
                data-location="<%= home.location %>"
                data-description="<%= home.description %>"
                data-price="<%= home.price %>"
                data-rating="<%= home.ratting %>"
                data-occupied="<%= home.occupied ? '1' : '0' %>">

                <img
                  src="<%= home.image %>"
                  alt="<%= home.houseName %>"
                  class="w-full h-48 object-cover"
                />
                <div class="p-4 flex-1 flex flex-col">

                  <div class="mb-2">
                    <% if (home.occupied) { %>
                      <span class="inline-flex items-center gap-1 text-xs font-medium text-blue-700 bg-blue-50 rounded-full px-2.5 py-1">
                        <i class="fa-solid fa-house-user"></i> Currently occupied
                      </span>
                    <% } else { %>
                      <span class="inline-flex items-center gap-1 text-xs font-medium text-green-700 bg-green-50 rounded-full px-2.5 py-1">
                        <i class="fa-solid fa-circle-check"></i> Available
                      </span>
                    <% } %>
                  </div>

                  <div class="flex items-start justify-between gap-2 mb-1">
                    <h4 class="text-lg font-semibold text-gray-800">
                      <%= home.houseName %>
                    </h4>
                    <span class="flex items-center shrink-0 text-sm font-medium text-gray-700 bg-yellow-100 px-3 py-1 rounded-full">
                      <svg class="w-4 h-4 text-yellow-500 me-1" fill="currentColor" viewBox="0 0 24 24"><path d="M13.849 4.22c-.684-1.626-3.014-1.626-3.698 0L8.397 8.387l-4.552.361c-1.775.14-2.495 2.331-1.142 3.477l3.468 2.937-1.06 4.392c-.413 1.713 1.472 3.067 2.992 2.149L12 19.35l3.897 2.354c1.52.918 3.405-.436 2.992-2.15l-1.06-4.39 3.468-2.938c1.353-1.146.633-3.336-1.142-3.477l-4.552-.36-1.754-4.17Z"/></svg>
                      <%= home.ratting %>
                    </span>
                  </div>

                  <% if (home.location) { %>
                    <p class="text-sm text-gray-500 mb-2 flex items-center">
                      <svg class="w-4 h-4 me-1 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                      </svg>
                      <%= home.location %>
                    </p>
                  <% } %>

                  <p class="text-gray-600 mb-2 line-clamp-2">
                    <%= home.description %>
                  </p>

                  <p class="text-gray-800 font-bold mt-auto">
                    Rs.<%= home.price %> <span class="font-normal text-gray-500">/ night</span>
                  </p>
                </div>
                <div class="p-4 pt-0 space-y-2">
                  <% if (!home.occupied) { %>
                    <a href="/homes/<%= home._id %>"
                      class="w-full inline-flex items-center justify-center text-white bg-red-500 hover:bg-red-600 border border-transparent focus:ring-4 focus:ring-red-300 shadow-sm font-medium leading-5 rounded-lg text-sm px-4 py-2 focus:outline-none transition duration-300">
                      <svg class="w-4 h-4 me-1.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 4h1.5L9 16m0 0h8m-8 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm8 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm-8.5-3h9.25L19 7H7.312"/></svg>
                      Book Now
                    </a>
                  <% } else { %>
                    <span class="w-full inline-flex items-center justify-center text-gray-400 bg-gray-100 font-medium leading-5 rounded-lg text-sm px-4 py-2 cursor-not-allowed">
                      Unavailable
                    </span>
                  <% } %>

                  <form action="/favourite-list/delete/<%= home._id %>" method="POST">
                    <button
                      type="submit"
                      class="w-full inline-flex items-center justify-center text-white bg-gray-500 hover:bg-gray-600 border border-transparent focus:ring-4 focus:ring-gray-300 shadow-sm font-medium leading-5 rounded-lg text-sm px-4 py-2 focus:outline-none transition duration-300"
                    >
                      <svg class="w-4 h-4 me-1.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M6 7h12M9 7V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v3m3 0-.867 12.142A2 2 0 0 1 15.138 21H8.862a2 2 0 0 1-1.995-1.858L6 7h12Z"/>
                      </svg>
                      Remove from Favourite
                    </button>
                  </form>
                </div>
              </div>
            <% }); %>
          </div>

          <p id="no-home-results" class="hidden bg-white border border-gray-200 rounded-xl p-8 text-center text-gray-400 text-sm mt-4 max-w-lg mx-auto">
            No favourites match your filters.
          </p>
        <% } else { %>
          <p class="text-gray-600 text-center col-span-full">
            No favourite homes found. Start adding some!
          </p>
        <% } %>
      </section>
    </main>

    <script>
      function applyHomeFilters() {
        const search = document.getElementById('home-search').value.trim().toLowerCase();
        const status = document.getElementById('home-status-filter').value;
        const sort = document.getElementById('home-sort').value;

        const grid = document.getElementById('home-grid');
        const cards = Array.from(grid.querySelectorAll('.home-card'));
        let visibleCount = 0;

        cards.forEach(card => {
          const loc = (card.dataset.location || '').toLowerCase();
          const desc = (card.dataset.description || '').toLowerCase();
          const occupied = card.dataset.occupied === '1';

          const matchesSearch = !search || loc.includes(search) || desc.includes(search);
          const matchesStatus = status === 'all' ||
            (status === 'occupied' && occupied) ||
            (status === 'vacant' && !occupied);

          const show = matchesSearch && matchesStatus;
          card.classList.toggle('hidden', !show);
          if (show) visibleCount++;
        });

        cards.sort((a, b) => {
          switch (sort) {
            case 'price-asc': return parseFloat(a.dataset.price) - parseFloat(b.dataset.price);
            case 'price-desc': return parseFloat(b.dataset.price) - parseFloat(a.dataset.price);
            case 'rating-desc':
            default: return parseFloat(b.dataset.rating) - parseFloat(a.dataset.rating);
          }
        });
        cards.forEach(card => grid.appendChild(card));

        document.getElementById('no-home-results').classList.toggle('hidden', visibleCount > 0);
        document.getElementById('home-results-count').textContent = `${visibleCount} of ${cards.length} homes`;
      }
      document.addEventListener('DOMContentLoaded', applyHomeFilters);
    </script>
  </body>
</html>